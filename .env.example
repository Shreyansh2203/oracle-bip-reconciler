# Oracle ERP Cloud BI Publisher base URL, e.g. https://erp.example.oraclecloud.com
# Must be https:// unless it points at loopback (or ALLOW_INSECURE_ORACLE_HTTP is true).
ORACLE_URL=https://erp.example.oraclecloud.com

# Dedicated BI Publisher service account. Never commit real values.
ORACLE_USER=YOUR_SERVICE_ACCOUNT_HERE
ORACLE_PASS=YOUR_SERVICE_ACCOUNT_PASSWORD_HERE

# Comma-separated browser origins allowed to call the API. Empty fails closed:
# no Access-Control-Allow-Origin header is emitted, so browsers block the response.
CORS_ORIGINS=https://app.example.com

# Set to true only to allow a plain http:// ORACLE_URL for a non-loopback host.
ALLOW_INSECURE_ORACLE_HTTP=false

# Optional shared cache. Falls back to an in-process TTL cache when unset.
REDIS_URL=

# Optional absolute report paths, overriding the defaults in src/constants.py.
ORACLE_BIP_INVOICE_PATH=
ORACLE_BIP_RECEIPT_PATH=

# Optional in-memory Oracle report cache lifetime, in seconds (default 60).
BIP_CACHE_TTL_SECONDS=60
